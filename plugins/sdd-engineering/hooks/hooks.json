{
  "description": "Write and Bash guards for the SDD agents. Each script acts only for its own agent (agent_type in the hook input) and needs jq.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/spec-creator-path-guard.sh" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/planner-path-guard.sh" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/implementer-path-guard.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/implementer-bash-guard.sh" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/readonly-bash-guard.sh" }
        ]
      }
    ]
  }
}
